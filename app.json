{
  "expo": {
    "name": "Wealth Monitor",
    "slug": "wealth-monitor",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "wealthmonitor",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/5f0506ef-1949-4a03-8758-1ee22b5c9255",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wealthmonitor",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "package": "com.wealthmonitor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "5f0506ef-1949-4a03-8758-1ee22b5c9255"
      }
    },
    "owner": "srnanvare007"
  }
}
